# 網站公開設定
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_QUOTE_WEBHOOK_URL=
NEXT_PUBLIC_YOUTUBE_PLAYLIST_ID=

# 身分驗證
# 至少 32 個字元；請為不同環境使用不同值。
AUTH_SECRET=

# PostgreSQL / Prisma
DATABASE_URL=
DIRECT_URL=

# Supabase Storage（只可在伺服器端使用）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# 初始管理員 seed；只有執行 npm run db:seed 時需要。
INITIAL_OWNER_USERNAME=
INITIAL_OWNER_PASSWORD=
INITIAL_OWNER_DISPLAY_NAME=

# 歷史 Notion 搬遷工具；一般網站執行不需要。
NOTION_TOKEN=
NOTION_DATABASE_ID=
NOTION_PARTNERS_DATABASE_ID=
